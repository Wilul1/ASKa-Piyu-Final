# Copied to repo-root `.env` (gitignored). Used by docker compose.
# Production: use a long random password. Local Docker: aska1234 is fine.

POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Optional: host port when using docker-compose.dev.yml (loopback only)
# POSTGRES_HOST_PORT=5432

# Optional: nginx published port for lab HTTP (`docker compose --profile full`)
# PROXY_PORT=8080

# Optional: ports when using docker-compose.https.yml (production TLS)
# HTTP_PORT=80
# HTTPS_PORT=443
