ASKA_CHROMA_PERSIST_DIR=./data/chroma
ASKA_CHROMA_COLLECTION_NAME=aska_knowledge_base
ASKA_RAG_TOP_K=5
# Semicolon-separated PDF paths for Chroma reset/rebuild (student handbook, faculty manual, charter).
# Host (uvicorn): paths under backend/data/documents/...
# Docker Compose: same ./data/documents/... form is remapped to ASKA_DOCUMENTS_PERSIST_DIR
# (/data/documents). Or set container paths explicitly: /data/documents/<id>/file.pdf
# ASKA_KB_REBUILD_DOCUMENT_PATHS=./data/documents/<id>/Laguna State Polytechnic University-CC_2026-1st Edition.pdf;./data/documents/<id>/LSPU Student Handbook.pdf;./data/documents/<id>/LSPU Faculty Manual 2020.pdf

# Local retrieval embedding model (multilingual: handles English/Tagalog/Taglish
# student phrasing). Ignored automatically when ASKA_ENV=test.
# Changing this requires a full /admin/kb/rebuild (or /admin/chroma/reset) —
# Chroma stores one embedding space per collection and cannot mix models.
ASKA_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
ASKA_EMBEDDING_DEVICE=cpu

# PostgreSQL application data only: users, offices, tickets, replies, auth, audit/statistics.
# Keep ChromaDB as the vector store for handbook/document chunks and RAG retrieval.
# development | production — production enables hard startup gates.
ASKA_ENV=development
# Defaults match docker-compose.yml (scripts/start_postgres.bat).
# If you use a local PostgreSQL install, replace the password with yours.
ASKA_DATABASE_URL=postgresql+psycopg://postgres:aska1234@localhost:5432/aska_piyu
# Pytest ALWAYS uses the test database. Never point this at aska_piyu.
ASKA_TEST_DATABASE_URL=postgresql+psycopg://postgres:aska1234@localhost:5432/aska_piyu_test
ASKA_ALLOW_DESTRUCTIVE_RESET=false
# Durable original PDF storage for citation grounding / source viewer.
ASKA_DOCUMENTS_PERSIST_DIR=./data/documents
ASKA_TICKET_ATTACHMENTS_DIR=./data/ticket_attachments
# Local/dev: true. Production: MUST be false — use `alembic upgrade head` instead.
ASKA_DATABASE_INIT_ON_STARTUP=true

# Required for POST /auth/login and Bearer token authentication.
ASKA_AUTH_SECRET_KEY=change-this-auth-secret
# 8 hours — shorter TTL when Remember me is off.
ASKA_AUTH_TOKEN_TTL_MINUTES=480
# 7 days — used when the client sends remember_me=true on login.
# ASKA_AUTH_REMEMBER_TOKEN_TTL_MINUTES=10080

# Shared X-Admin-Key for scripts/local admin panel ONLY.
# Production default is OFF (admin Bearer login). Keep false for campus deploys:
ASKA_ALLOW_ADMIN_API_KEY=false
# Only needed when ASKA_ALLOW_ADMIN_API_KEY=true (local scripts/CI):
# ASKA_ADMIN_API_KEY=change-this-admin-key

ASKA_GROQ_API_KEY=
ASKA_GROQ_MODEL=llama-3.3-70b-versatile
ASKA_GROQ_TIMEOUT_SECONDS=30
# ASKA_GROQ_API_KEY/ASKA_GROQ_MODEL hold the credential/model for whichever
# OpenAI-compatible chat-completions endpoint ASKA_LLM_BASE_URL points at —
# despite the name, this does not have to be Groq. Groq's Cloudflare edge
# blocks requests from cloud/datacenter IPs (Azure, AWS, GCP), so a server
# deployment may need a different provider; GitHub Models works well from
# Azure since it is Microsoft-owned infrastructure. To switch to GitHub
# Models: set ASKA_GROQ_API_KEY to a GitHub PAT with the `models: read`
# scope, ASKA_GROQ_MODEL to e.g. openai/gpt-4o-mini, and uncomment below.
# ASKA_LLM_BASE_URL=https://models.github.ai/inference/chat/completions
# ASKA_LLM_EXTRA_HEADERS_JSON={"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}

# Use explicit origins in production (never "*"). For Flutter web, pin a port:
# flutter run -d chrome --web-port=8080
ASKA_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Email verification — prefer Gmail SMTP (no custom domain needed).
# Create a dedicated Gmail (e.g. askapiyu@gmail.com), enable 2-Step Verification,
# then generate an App Password (Google Account → Security → App passwords).
# ASKA_SMTP_HOST=smtp.gmail.com
# ASKA_SMTP_PORT=587
# ASKA_SMTP_USERNAME=askapiyu@gmail.com
# ASKA_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# ASKA_SMTP_FROM_EMAIL=askapiyu@gmail.com
# ASKA_SMTP_USE_TLS=true
#
# Optional Resend fallback (needs verified domain to email arbitrary recipients):
# ASKA_RESEND_API_KEY=
# ASKA_RESEND_FROM_EMAIL=ASKa-Piyu <onboarding@resend.dev>
# ASKA_EMAIL_VERIFICATION_CODE_TTL_MINUTES=30
# ASKA_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# One-time bootstrap passwords (scripts/seed_admin.py, seed_office_accounts.py)
# ASKA_SEED_ADMIN_EMAIL=admin@aska.local
# ASKA_SEED_ADMIN_PASSWORD=
# Required in production before: python scripts/seed_office_accounts.py
# ASKA_SEED_OFFICE_PASSWORD=

# Production checklist (ASKA_ENV=production):
# - Strong unique ASKA_AUTH_SECRET_KEY (required; never change-this / change-me)
# - ASKA_DATABASE_URL set; ASKA_DATABASE_INIT_ON_STARTUP=false; alembic upgrade head
# - Explicit ASKA_CORS_ORIGINS HTTPS hosts (no "*" and not localhost-only)
# - ASKA_ALLOW_ADMIN_API_KEY=false + admin Bearer login
# - ASKA_GROQ_API_KEY set
# - ASKA_KB_REBUILD_DOCUMENT_PATHS set to real charter/handbook/faculty-manual PDFs
# - After any embedding model change (ASKA_EMBEDDING_MODEL_NAME), call
#   POST /admin/kb/rebuild to re-index everything into the new vector space
# - Put nginx/Caddy rate limits in front of /auth/* and /qa/ask (see deploy/)
# - Behind Compose nginx / a trusted proxy, enable real-client rate-limit keys:
#   ASKA_TRUST_PROXY=true
# - Signup: keep ASKA_ALLOW_PUBLIC_SIGNUP=true; students verify email via Resend
#   (ASKA_RESEND_API_KEY + ASKA_RESEND_FROM_EMAIL). Tickets require verified email.
#   Optional extra gates: ASKA_SIGNUP_ALLOWED_EMAIL_DOMAINS / ASKA_SIGNUP_INVITE_CODE
#   Or disable: ASKA_ALLOW_PUBLIC_SIGNUP=false
# - Backup encryption passphrase (used by scripts/backup_aska.*):
#   ASKA_BACKUP_PASSPHRASE=replace-with-long-random
# - One-shot lab harden (rotate passwords + signup + backup pass):
#   python scripts/harden_lab_ops.py --apply-db
# - Create first admin: python scripts/seed_admin.py
# - Seed offices + aliases (ticket routing): seed_office_accounts.py then seed_office_aliases.py
# - LAB ONLY: never expose docker-compose HTTP :8080 on the public internet
